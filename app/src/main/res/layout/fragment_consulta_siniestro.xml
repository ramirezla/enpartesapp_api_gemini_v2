<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etCaseNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/case_number_hint"
        android:inputType="text"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/etCaseToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/case_token_hint"
        android:inputType="text"
        android:minHeight="48dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/consult" />

        <Button
            android:id="@+id/btnDownloadPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/download_pdf" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/llResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Here we will add the TextViews dynamically -->
        </LinearLayout>
    </ScrollView>

</LinearLayout>